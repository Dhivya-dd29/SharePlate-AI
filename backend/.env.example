# SharePlate AI Server Configuration
PORT=5000
NODE_ENV=development

# Database Dialect: sqlite | postgres | mysql
DB_DIALECT=sqlite
DB_PATH=database/shareplate.db

# Optional Postgres / MySQL Credentials (if DB_DIALECT is postgres or mysql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shareplate_db
DB_USER=postgres
DB_PASSWORD=postgres

# AI Recommendation Microservice URL
AI_SERVICE_URL=http://localhost:5001

# JWT Secret Key for Authentication
JWT_SECRET=shareplate_ai_secure_jwt_secret_key_2026

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173
